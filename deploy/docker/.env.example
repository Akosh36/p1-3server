# Copy to .env in this directory and fill in real values before running
# `docker compose up -d --build` (see docs/deploy.md).

# Postgres password for the p13server database user.
POSTGRES_PASSWORD=

# Signing key for API session/auth tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# CORS origins the API accepts, comma-separated. "*" is fine for local/LAN use.
ALLOWED_ORIGINS=*

# One-time bootstrap admin, created only if the admins table is empty.
# Unset both after your first successful login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
